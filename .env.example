# --- Claude via AWS Bedrock ---
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
# Use ONE of: a Bedrock API key, a named profile, or access keys
AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Models (Bedrock inference profile IDs) ---
MAIN_MODEL=us.anthropic.claude-opus-5-5
# "inherit" = same as MAIN_MODEL; or e.g. us.anthropic.claude-sonnet-5-5 to cut cost
SUBAGENT_MODEL=inherit

# --- Data ---
DB_PATH=data/market.db
# Calendar days of daily history to keep per stock (needs >= ~300 for SMA200 + 52-week levels)
HISTORY_DAYS=550
# Archive of downloaded quarterly-results XBRL files (one folder per symbol)
FILINGS_DIR=data/filings

# --- Pagination / NSE politeness ---
FETCH_BATCH_SIZE=25
FETCH_BATCH_PAUSE=3
# Cost/time estimates shown in the count picker
EST_BASE_COST=0.40
EST_PER_STOCK_COST=0.07
